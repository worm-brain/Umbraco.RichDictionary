<Project>
  <!-- Central package management: every package version is declared once, here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Umbraco versions per major (UmbracoMajor comes from Directory.Build.props).
    UmbracoPackageRange: what the package compiles against (the floor) and declares to NuGet, so any
    site of that major can install it.
    UmbracoDevVersion: the concrete version the sample sites and tests run, pinned with VersionOverride
    where a project references a package that also carries the range.
  -->
  <PropertyGroup Condition="'$(UmbracoMajor)' == '17'">
    <UmbracoPackageRange>[17.0.0, 18.0.0)</UmbracoPackageRange>
    <UmbracoDevVersion>17.7.1</UmbracoDevVersion>
    <MarkdigFloor>0.41.0</MarkdigFloor>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmbracoMajor)' == '18'">
    <UmbracoPackageRange>[18.0.0, 19.0.0)</UmbracoPackageRange>
    <UmbracoDevVersion>18.2.1</UmbracoDevVersion>
    <MarkdigFloor>1.1.3</MarkdigFloor>
  </PropertyGroup>

  <ItemGroup Label="Umbraco">
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms" Version="$(UmbracoDevVersion)" />
    <PackageVersion
      Include="Umbraco.Cms.DevelopmentMode.Backoffice"
      Version="$(UmbracoDevVersion)"
    />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
  </ItemGroup>

  <ItemGroup Label="Package">
    <!--
      A floor per major (MarkdigFloor above), not a pin, so NuGet unifies with the copy Umbraco ships
      rather than pinning a second one. Umbraco 17 references Markdig from 17.x onwards (0.45.0 in
      17.7; 17.0 used a different Markdown library), hence 0.41.0. Umbraco 18.0.0 requires 1.1.3 or
      later, so a lower floor there is a package downgrade (NU1605).
    -->
    <PackageVersion Include="Markdig" Version="$(MarkdigFloor)" />
  </ItemGroup>

  <ItemGroup Label="Security">
    <!--
      Patched versions of packages Umbraco brings in transitively, for the test and sample projects
      only (the package itself audits direct references only). Remove these once Umbraco ships them.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>
</Project>
