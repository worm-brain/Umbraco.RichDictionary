<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit v3 on Microsoft.Testing.Platform (global.json), so the test project is its own executable. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Umbraco.Community.RichDictionary.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test against the same Umbraco version as the test site rather than the package's 17.0.0 floor. -->
    <PackageReference Include="Umbraco.Cms.Web.Website" VersionOverride="$(UmbracoDevVersion)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" VersionOverride="$(UmbracoDevVersion)" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Patched versions of packages Umbraco brings in transitively, which the NuGet audit flags as
      vulnerable (and warnings are errors). Remove these once Umbraco ships them.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Umbraco.Community.RichDictionary\Umbraco.Community.RichDictionary.csproj" />
  </ItemGroup>
</Project>
