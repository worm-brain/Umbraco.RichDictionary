<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Transitive packages resolve at the Umbraco 17.0.0 floor here; consuming sites resolve (and audit) their own newer versions. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Umbraco.RichDictionary</PackageId>
    <Product>Umbraco.RichDictionary</Product>
    <Title>Umbraco.RichDictionary</Title>
    <Description>Drop-in replacement for the Umbraco Translation section that edits dictionary values with a rich text (Tiptap) or Markdown editor.</Description>
    <PackageTags>umbraco;umbraco-marketplace;dictionary;translation;tiptap;markdown</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floor at 17.0.0 so any Umbraco 17 site can install the package; the test site pins the version we develop against. -->
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="[17.0.0, 18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[17.0.0, 18.0.0)" />
    <!-- Umbraco itself references Markdig from 17.x onwards (0.45.0 in 17.7); this floor lets NuGet unify with it rather than pin a second copy. Umbraco 17.0 used a different Markdown library. -->
    <PackageReference Include="Markdig" Version="0.41.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Lit client source is not part of the package; only its build output in wwwroot is. -->
    <Content Remove="Client\**" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbraco.RichDictionary.Tests" />
  </ItemGroup>

  <!--
    The client's build output is gitignored, so packing has to build it. This happens on `dotnet pack` only
    (the CLI sets _IsPacking), so C#-only work never needs Bun. Pass -p:BuildClient=true to build it on an
    ordinary `dotnet build` too.
  -->
  <PropertyGroup>
    <BuildClient Condition="'$(BuildClient)' == ''">$(_IsPacking)</BuildClient>
    <ClientDirectory>$(MSBuildProjectDirectory)\Client\</ClientDirectory>
    <ClientOutputDirectory>wwwroot\App_Plugins\UmbracoRichDictionary\</ClientOutputDirectory>
  </PropertyGroup>

  <!--
    Runs before static web assets are resolved. They are discovered from @(Content), whose wwwroot glob was
    evaluated before this target wrote the files, so the client output is re-globbed afterwards: without that,
    a pack from a clean checkout ships no client, and a rebuild with new chunk hashes points at deleted files.
    The NoBuild check is needed because a BeforeTargets hook still runs when its target is skipped.
  -->
  <Target Name="BuildClient" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(BuildClient)' == 'true' and '$(NoBuild)' != 'true'">
    <Exec Command="bun --version" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_BunExitCode" />
    </Exec>
    <Error
      Condition="'$(_BunExitCode)' != '0'"
      Text="Bun is required to build the Umbraco.RichDictionary back-office client, but 'bun' was not found on PATH. Install it from https://bun.sh and try again."
    />

    <Exec Command="bun install --frozen-lockfile" WorkingDirectory="$(ClientDirectory)" Condition="Exists('$(ClientDirectory)bun.lock')" />
    <Exec Command="bun run build" WorkingDirectory="$(ClientDirectory)" />

    <ItemGroup>
      <Content Remove="$(ClientOutputDirectory)**" />
      <Content Include="$(ClientOutputDirectory)**" />
    </ItemGroup>
  </Target>

  <!-- Catches packs that skip BuildClient (a no-build `dotnet pack`, or `msbuild -t:Pack`) on a checkout with no client build. -->
  <Target Name="EnsureClientBuilt" BeforeTargets="GenerateNuspec">
    <Error
      Condition="!Exists('$(ClientOutputDirectory)umbraco-rich-dictionary.js')"
      Text="The back-office client has not been built, so the package would ship without it. Pack with `dotnet pack` (which builds it), or run `bun run build` in src/Umbraco.RichDictionary/Client first."
    />
  </Target>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>
</Project>
