{
  "name": "umbraco-community-rich-dictionary",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc && tsc -p e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "bun e2e/prepare.ts && playwright test",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "docs:screenshots": "playwright test -c playwright.docs.config.ts",
    "generate": "bun scripts/generate-openapi.ts https://localhost:44440/umbraco/swagger/umbracorichdictionary/swagger.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "@umbraco-cms/backoffice": "^17.8.0",
    "@vitest/browser-playwright": "^5.0.3",
    "happy-dom": "^20.14.6",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
