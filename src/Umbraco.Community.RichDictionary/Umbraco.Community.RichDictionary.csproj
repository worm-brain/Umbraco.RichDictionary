<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <!-- Transitive packages resolve at the Umbraco floor (17.0.0 or 18.0.0) here; consuming sites resolve (and audit) their own newer versions. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The Umbraco. prefix is reserved on nuget.org, so community packages publish as Umbraco.Community.*, and the
      assembly, namespaces and manifest id follow it. It must match the buildTransitive/<PackageId>.targets file
      name, which is the only name NuGet imports automatically.
    -->
    <PackageId>Umbraco.Community.RichDictionary</PackageId>
    <Product>Umbraco.Community.RichDictionary</Product>
    <Title>Umbraco Rich Dictionary</Title>
    <Description>Edit Umbraco dictionary values with a rich text (Tiptap) or Markdown editor instead of a plain textarea.</Description>
    <PackageTags>umbraco;umbraco-marketplace;dictionary;translation;tiptap;markdown</PackageTags>
    <!--
      One package line per Umbraco major (UmbracoMajor in Directory.Build.props): 17.x.y for Umbraco 17,
      18.x.y for 18. Releases pass the full version (-p:Version=17.1.0); local builds are
      $(UmbracoMajor).0.0-dev. The client build stamps it into umbraco-package.json (see
      Client/scripts/umbraco-package-version.ts).
    -->
    <Version>$(UmbracoMajor).0.0-dev</Version>
    <!-- Authors, licence, repository, Source Link, symbols, icon and NuGet readme are shared, in Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The appsettings schema, added to the site's appsettings-schema.json by buildTransitive/Umbraco.Community.RichDictionary.targets. -->
    <Content Remove="appsettings-schema.Umbraco.Community.RichDictionary.json" />
    <None Remove="appsettings-schema.Umbraco.Community.RichDictionary.json" />
    <None
      Include="appsettings-schema.Umbraco.Community.RichDictionary.json"
      Pack="true"
      PackagePath="\"
    />
    <None
      Update="buildTransitive\Umbraco.Community.RichDictionary.targets"
      Pack="true"
      PackagePath="buildTransitive\Umbraco.Community.RichDictionary.targets"
    />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions in Directory.Packages.props: Umbraco at the major's range (UmbracoPackageRange), Markdig at its 0.41.0 floor. -->
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Lit client source is not part of the package; only its build output in wwwroot is. -->
    <Content Remove="Client\**" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbraco.Community.RichDictionary.Tests" />
  </ItemGroup>

  <!--
    The client's build output is gitignored, so packing has to build it. This happens on `dotnet pack` only
    (the CLI sets _IsPacking), so C#-only work never needs Bun. Pass -p:BuildClient=true to build it on an
    ordinary `dotnet build` too.
  -->
  <PropertyGroup>
    <BuildClient Condition="'$(BuildClient)' == ''">$(_IsPacking)</BuildClient>
    <ClientDirectory>$(MSBuildProjectDirectory)\Client\</ClientDirectory>
    <ClientOutputDirectory>wwwroot\App_Plugins\UmbracoCommunityRichDictionary\</ClientOutputDirectory>
  </PropertyGroup>

  <!--
    Runs before static web assets are resolved. They are discovered from @(Content), whose wwwroot glob was
    evaluated before this target wrote the files, so the client output is re-globbed afterwards: without that,
    a pack from a clean checkout ships no client, and a rebuild with new chunk hashes points at deleted files.
    The NoBuild check is needed because a BeforeTargets hook still runs when its target is skipped.
  -->
  <Target
    Name="BuildClient"
    BeforeTargets="ResolveProjectStaticWebAssets"
    Condition="'$(BuildClient)' == 'true' and '$(NoBuild)' != 'true'"
  >
    <Exec
      Command="bun --version"
      IgnoreExitCode="true"
      EchoOff="true"
      StandardOutputImportance="low"
      StandardErrorImportance="low"
    >
      <Output TaskParameter="ExitCode" PropertyName="_BunExitCode" />
    </Exec>
    <Error
      Condition="'$(_BunExitCode)' != '0'"
      Text="Bun is required to build the Umbraco.Community.RichDictionary back-office client, but 'bun' was not found on PATH. Install it from https://bun.sh and try again."
    />

    <Exec
      Command="bun install --frozen-lockfile"
      WorkingDirectory="$(ClientDirectory)"
      Condition="Exists('$(ClientDirectory)bun.lock')"
    />
    <!-- Passes the version on so a -p:Version override reaches umbraco-package.json too. -->
    <Exec
      Command="bun run build"
      WorkingDirectory="$(ClientDirectory)"
      EnvironmentVariables="RICH_DICTIONARY_VERSION=$(PackageVersion)"
    />

    <ItemGroup>
      <Content Remove="$(ClientOutputDirectory)**" />
      <Content Include="$(ClientOutputDirectory)**" />
    </ItemGroup>
  </Target>

  <!-- Catches packs that skip BuildClient (a no-build `dotnet pack`, or `msbuild -t:Pack`) on a checkout with no client build. -->
  <Target Name="EnsureClientBuilt" BeforeTargets="GenerateNuspec">
    <Error
      Condition="!Exists('$(ClientOutputDirectory)umbraco-community-rich-dictionary.js')"
      Text="The back-office client has not been built, so the package would ship without it. Pack with `dotnet pack` (which builds it), or run `bun run build` in src/Umbraco.Community.RichDictionary/Client first."
    />
  </Target>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>
</Project>
